{
  "name": "@app/web",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx ../../packages/infisical-runner/src/cli.ts web dev -- vite dev",
    "build": "tsx ../../packages/infisical-runner/src/cli.ts web build -- vite build",
    "build:ci": "vite build",
    "start": "vite preview",
    "start:ci": "node .output/server/index.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "tsx ../../packages/infisical-runner/src/cli.ts web test:e2e -- playwright test --grep-invert @mutation",
    "test:e2e:ci": "playwright test --grep-invert @mutation",
    "test:e2e:local": "playwright test --config=playwright.local.config.ts",
    "test": "tsx ../../packages/infisical-runner/src/cli.ts web test -- vitest run --project=unit --passWithNoTests",
    "test:ci": "vitest run --project=unit --passWithNoTests",
    "test-storybook": "vitest run --project=storybook",
    "test:watch": "tsx ../../packages/infisical-runner/src/cli.ts web test:watch -- vitest --project=unit --passWithNoTests",
    "test:watch:no-infisical": "vitest --project=unit --passWithNoTests"
  },

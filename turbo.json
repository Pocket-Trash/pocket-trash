{
  "$schema": "https://v2-10-4.turborepo.dev/schema.json",
  "globalDependencies": [".env", ".env.*"],
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:web": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "AXIOM_DATASET",
        "AXIOM_EDGE_DOMAIN",
        "AXIOM_TOKEN",
        "ASSET_FOLDER_PREFIX",
        "CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "DATABASE_URL",
        "LOGGER",
        "LOG_LEVEL",
        "LOG_PROXY_CLIENT_KEY",
        "LOG_PROXY_URL",
        "NITRO_PRESET",
        "PORT",
        "RESOURCE_CDN_BASE_URL",
        "RESOURCE_CDN_TOKEN_KEY",
        "RESOURCE_FOLDER_PREFIX",
        "RESOURCE_API_BASE_URL",
        "RESOURCE_STORAGE_ACCESS_KEY",
        "RESOURCE_STORAGE_ENDPOINT",
        "RESOURCE_STORAGE_ZONE_NAME",
        "SITE_URL",
        "VERCEL_ENV",
        "VERCEL_GIT_PULL_REQUEST_ID",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "VITE_ASSET_FOLDER_PREFIX",
        "VITE_CDN_BASE_URL",
        "VITE_CLERK_SIGN_IN_URL",
        "VITE_CLERK_SIGN_UP_URL",
        "VITE_LOG_PROXY_CLIENT_KEY",
        "VITE_LOG_PROXY_URL",
        "VITE_RESOURCE_API_BASE_URL"
      ],
      "outputs": ["dist/**", "build/**", ".output/**", ".vercel/output/**"]
    },
    "build:ci": {
      "dependsOn": ["^build:ci"],
      "env": [
        "AXIOM_DATASET",
        "AXIOM_EDGE_DOMAIN",
        "AXIOM_TOKEN",
        "ASSET_FOLDER_PREFIX",
        "CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "DATABASE_URL",
        "LOGGER",
        "LOG_LEVEL",
        "LOG_PROXY_CLIENT_KEY",
        "LOG_PROXY_URL",
        "NITRO_PRESET",
        "PORT",
        "RESOURCE_CDN_BASE_URL",
        "RESOURCE_CDN_TOKEN_KEY",
        "RESOURCE_FOLDER_PREFIX",
        "RESOURCE_API_BASE_URL",
        "RESOURCE_STORAGE_ACCESS_KEY",
        "RESOURCE_STORAGE_ENDPOINT",
        "RESOURCE_STORAGE_ZONE_NAME",
        "SITE_URL",
        "VERCEL_ENV",
        "VERCEL_GIT_PULL_REQUEST_ID",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "VITE_ASSET_FOLDER_PREFIX",
        "VITE_CDN_BASE_URL",
        "VITE_CLERK_SIGN_IN_URL",
        "VITE_CLERK_SIGN_UP_URL",
        "VITE_LOG_PROXY_CLIENT_KEY",
        "VITE_LOG_PROXY_URL",
        "VITE_RESOURCE_API_BASE_URL"
      ],
      "outputs": ["dist/**", "build/**", ".output/**", ".vercel/output/**"]
    },
    "lint": {
      "outputs": []
    },
    "check": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:ci": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:watch:no-infisical": {
      "cache": false,
      "persistent": true
    }
  }
}

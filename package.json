{
  "name": "pocket-trash.app",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev --filter='./apps/*' --filter=@package/logger",
    "dev:scraper": "node scripts/dev-scraper.mjs",
    "scraper:cron": "node scripts/scraper-command.mjs cron:run",
    "scraper:process": "node scripts/scraper-command.mjs process:queue",
    "scraper:process:dead-letter": "node scripts/scraper-command.mjs process:dead-letter",
    "scraper:process:queue": "node scripts/scraper-command.mjs process:queue",
    "scraper:scrape": "node scripts/scraper-command.mjs scrape",
    "scraper:scrape:autmog": "node scripts/scraper-command.mjs scrape:autmog",
    "scraper:scrape:grimsmo-fjell": "node scripts/scraper-command.mjs scrape:grimsmo-fjell",
    "scraper:scrape:grimsmo-norseman": "node scripts/scraper-command.mjs scrape:grimsmo-norseman",
    "scraper:scrape:grimsmo-rask": "node scripts/scraper-command.mjs scrape:grimsmo-rask",
    "scraper:scrape:grimsmo-saga": "node scripts/scraper-command.mjs scrape:grimsmo-saga",
    "dev:web": "turbo run dev:web --filter=@app/web --filter=@package/logger",
    "build": "turbo run build",
    "build:ci": "turbo run build:ci",
    "start": "pnpm --filter @app/scraper run cron:run",
    "bunny:audit": "tsx packages/infisical-runner/src/cli.ts bunny audit -- node scripts/audit-bunny-services.mjs",
    "db:generate": "pnpm --filter @package/database db:generate",
    "db:migrate": "pnpm --filter @package/database db:migrate",
    "db:resolve-conflicts": "pnpm --filter @package/database db:resolve-conflicts",
    "db:view": "pnpm --filter @package/database db:view",
    "diagram:infra": "node scripts/generate-infrastructure-diagram.mjs --once --refresh-metadata",
    "lint": "biome lint . && turbo run lint",
    "format": "biome check --write --linter-enabled=false .",
    "logger:axiom:map-fields": "pnpm --filter @package/logger run axiom:map-fields",
    "figjam": "tsx packages/figjam/src/cli.ts",
    "figjam:read": "tsx packages/figjam/src/cli.ts read",
    "figjam:serve": "tsx packages/figjam/src/cli.ts serve-outbox",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "check": "biome check --write . && turbo run check",
    "typecheck": "turbo run typecheck",
    "infisical:check": "tsx packages/infisical-runner/src/check-auth.ts",
    "test": "pnpm infisical:check && turbo run test",
    "test:ci": "turbo run test:ci",
    "test:logger:axiom": "tsx packages/infisical-runner/src/cli.ts logger test:axiom -- tsx packages/logger/integration/axiom-live.ts",
    "test:watch": "turbo run test:watch",
    "test:watch:no-infisical": "turbo run test:watch:no-infisical"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "latest",
    "@types/node": "latest",
    "concurrently": "^10.0.3",
    "drizzle-lab": "^0.11.0",
    "drizzle-view": "^0.0.4",
    "eslint": "latest",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wait-on": "^9.0.10",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1",
      "utf-8-validate": "5.0.10"
    }
  }
}

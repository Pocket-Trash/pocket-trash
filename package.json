{
  "name": "pocket-trash.app",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "agent-skills:update": "npx skills add pocket-trash/skills --skill '*' --agent codex claude-code -y",
    "build": "turbo run build",
    "build:ci": "turbo run build:ci",
    "bunny:audit": "tsx packages/infisical-runner/src/cli.ts bunny audit -- node scripts/audit-bunny-services.mjs",
    "changeset": "changeset",
    "db:generate": "pnpm --filter @package/database db:generate",
    "db:migrate": "pnpm --filter @package/database db:migrate",
    "db:resolve-conflicts": "pnpm --filter @package/database db:resolve-conflicts",
    "db:seed": "pnpm --filter @package/database db:seed",
    "db:view": "pnpm --filter @package/database db:view",
    "deploy": "pnpm --filter @app/api run deploy",
    "deploy:development": "pnpm --filter @app/api run deploy:development",
    "deploy:preview": "pnpm --filter @app/api run deploy:preview",
    "dev": "turbo run dev --filter=@app/api --filter=@app/web --filter=@package/logger",
    "dev:all": "turbo run dev --filter='./apps/*' --filter=@package/logger",
    "dev:scraper": "node scripts/dev-scraper.mjs",
    "dev:verbose": "INFISICAL_RUNNER_VERBOSE=1 pnpm dev",
    "dev:webhooks": "pnpm users:reconcile && tsx packages/infisical-runner/src/cli.ts webhooks listen -- node scripts/dev-webhooks.mjs",
    "diagram:infra": "node scripts/generate-infrastructure-diagram.mjs --once --refresh-metadata",
    "figjam": "tsx packages/figjam/src/cli.ts",
    "figjam:read": "tsx packages/figjam/src/cli.ts read",
    "figjam:serve": "tsx packages/figjam/src/cli.ts serve-outbox",
    "format": "biome check --write --linter-enabled=false .",
    "infisical:check": "tsx packages/infisical-runner/src/check-auth.ts",
    "lint": "eslint . && pnpm lint:jsdoc",
    "lint:jsdoc": "node scripts/check-jsdoc.mjs",
    "logger:axiom:map-fields": "pnpm --filter @package/logger run axiom:map-fields",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "release": "node scripts/release.mjs",
    "resources:reconcile-storage": "tsx packages/infisical-runner/src/cli.ts database resources:reconcile-storage -- tsx packages/database/scripts/reconcile-resource-storage.ts",
    "scraper:cron": "node scripts/scraper-command.mjs cron:run",
    "scraper:process:dead-letter": "node scripts/scraper-command.mjs process:dead-letter",
    "scraper:process:queue": "node scripts/scraper-command.mjs process:queue",
    "scraper:scrape": "node scripts/scraper-command.mjs scrape",
    "start": "pnpm --filter @app/scraper run cron:run",
    "storybook": "pnpm --filter @app/web storybook --no-open",
    "test": "pnpm test:jsdoc && pnpm test:workflows && pnpm infisical:check && turbo run test",
    "test:ci": "pnpm test:jsdoc && pnpm test:workflows && turbo run test:ci",
    "test:jsdoc": "node --test scripts/check-jsdoc.test.mjs",
    "test:logger:axiom": "tsx packages/infisical-runner/src/cli.ts logger test:axiom -- tsx packages/logger/integration/axiom-live.ts",
    "test:watch": "turbo run test:watch",
    "test:watch:no-infisical": "turbo run test:watch:no-infisical",
    "test:workflows": "node --test scripts/database-change-detection.test.mjs scripts/check-changelog-reminder.test.mjs scripts/developer-commands.test.mjs",
    "typecheck": "turbo run typecheck",
    "users:reconcile": "pnpm --filter @app/api users:reconcile"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@package/lint": "workspace:*",
    "@storybook/builder-vite": "10.6.1",
    "@types/node": "latest",
    "concurrently": "^10.0.3",
    "drizzle-lab": "^0.11.0",
    "drizzle-view": "^0.0.4",
    "eslint": "latest",
    "eslint-plugin-jsdoc": "^65.0.1",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wait-on": "^9.0.10",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.3",
      "drizzle-orm@0.45.3>expo-sqlite": "-",
      "lightningcss": "1.30.1",
      "utf-8-validate": "5.0.10"
    }
  }
}

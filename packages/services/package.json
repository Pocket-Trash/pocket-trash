{
  "name": "@package/services",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./authorization": {
      "types": "./dist/authorization.d.ts",
      "default": "./dist/authorization.js"
    },
    "./catalog-slug": {
      "types": "./dist/catalog-slug.d.ts",
      "default": "./dist/catalog-slug.js"
    },
    "./catalog-terminology": {
      "types": "./dist/catalog-terminology.d.ts",
      "default": "./dist/catalog-terminology.js"
    },
    "./catalog-import": {
      "types": "./dist/catalog-import/index.d.ts",
      "default": "./dist/catalog-import/index.js"
    },
    "./measurements": {
      "types": "./dist/measurements.d.ts",
      "default": "./dist/measurements.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ci": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"dist/**\"",
    "test:ci": "vitest run --passWithNoTests --exclude \"dist/**\"",
    "test:watch": "vitest --passWithNoTests --exclude \"dist/**\"",
    "test:watch:no-infisical": "vitest --passWithNoTests --exclude \"dist/**\"",
    "test:storage": "node scripts/test-storage.mjs"
  },
  "dependencies": {
    "@package/database": "workspace:*",
    "@package/feature-flags": "workspace:*",
    "@package/logger": "workspace:*",
    "@package/storage": "workspace:*",
    "@pocket-trash/localizations": "^0.27.0",
    "drizzle-orm": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@package/tsconfig": "workspace:*",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  }
}

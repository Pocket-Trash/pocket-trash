// Pocket Trash Infrastructure
// Generated by `pnpm diagram:infra` from `docs/infrastructure-diagram.yaml`.
// Edit the YAML metadata, then rerun the generator.
direction right
colorMode pastel
styleMode plain
typeface clean

prod [color: green, label: "Production"] {
  prod_Web [label: "Web"] {
    prod_web [color: black, icon: vercel, label: "apps/web\nTanStack Start"]
  }
  prod_Ingestion [label: "Ingestion"] {
    prod_scraper [color: purple, icon: server, label: "apps/scraper\nRailway service"]
  }
  prod_Data [label: "Data"] {
    prod_neon [color: green, icon: postgresql, label: "Neon production branch"]
  }
  prod_Secrets [label: "Secrets"] {
    prod_infisical [color: purple, icon: lock, label: "Infisical prod secrets"]
  }
  prod_Observability [label: "Observability"] {
    prod_axiom [color: blue, icon: activity, label: "Axiom production dataset"]
  }
  prod_Identity [label: "Identity"] {
    prod_clerk [color: purple, icon: lock, label: "Clerk auth"]
  }
  prod_Automation [label: "Automation"] {
    prod_github_actions [color: gray, icon: github, label: "release workflows"]
  }
}

prod_github_actions > prod_web: deploy web
prod_github_actions > prod_scraper: deploy scraper
prod_github_actions > prod_neon: run migrations
prod_web > prod_neon: read/write
prod_web > prod_axiom: server and browser logs
prod_scraper > prod_neon: write product data
prod_scraper > prod_axiom: service logs

preview [color: yellow, label: "Preview"] {
  preview_Web [label: "Web"] {
    preview_web [color: black, icon: vercel, label: "Vercel preview"]
  }
  preview_Ingestion [label: "Ingestion"] {
    preview_scraper [color: purple, icon: server, label: "Railway preview scraper"]
  }
  preview_Data [label: "Data"] {
    preview_neon [color: green, icon: postgresql, label: "Neon preview branch"]
  }
  preview_Secrets [label: "Secrets"] {
    preview_infisical [color: purple, icon: lock, label: "Infisical preview secrets"]
  }
  preview_Observability [label: "Observability"] {
    preview_axiom [color: blue, icon: activity, label: "Axiom preview dataset"]
  }
}

preview_web > preview_neon: branch DATABASE_URL
preview_web > preview_axiom: same-origin log ingestion
preview_scraper > preview_neon: isolated data writes

dev [color: blue, label: "Local Development"] {
  dev_Web [label: "Web"] {
    dev_web [color: black, icon: vercel, label: "apps/web\nlocalhost:4005"]
  }
  dev_Ingestion [label: "Ingestion"] {
    dev_scraper [color: purple, icon: server, label: "apps/scraper"]
  }
  dev_Data [label: "Data"] {
    dev_neon [color: green, icon: postgresql, label: "developer database"]
  }
  dev_Secrets [label: "Secrets"] {
    dev_infisical [color: purple, icon: lock, label: "Infisical dev secrets"]
  }
}

dev_infisical > dev_web: local env
dev_infisical > dev_scraper: local env
dev_web > dev_neon: read/write

shared_packages [label: "Shared packages and detected runtime links", color: "gray"] {
  app_scraper [icon: box, label: "@app/scraper\napps/scraper"]
  app_web [icon: box, label: "@app/web\napps/web"]
  package_database [icon: package, label: "@package/database\npackages/database"]
  package_feature_flags [icon: package, label: "@package/feature-flags\npackages/feature-flags"]
  package_storage [icon: package, label: "@package/storage\npackages/storage"]
  package_json_data [icon: package, label: "@package/json-data\npackages/json-data"]
  package_logger [icon: package, label: "@package/logger\npackages/logger"]
  package_markdown [icon: package, label: "@package/markdown\npackages/markdown"]
  package_services [icon: package, label: "@package/services\npackages/services"]
  service_github_actions [color: gray, icon: github, label: "GitHub Actions"]
  service_vercel [color: black, icon: vercel, label: "Vercel"]
  service_railway [color: purple, icon: server, label: "Railway"]
  service_neon [color: green, icon: postgresql, label: "Neon Postgres"]
  service_infisical [color: purple, icon: lock, label: "Infisical"]
  service_axiom [color: blue, icon: activity, label: "Axiom"]
  service_clerk [color: purple, icon: lock, label: "Clerk"]
  service_discord [color: indigo, icon: message-circle, label: "Discord"]
  service_figjam [color: pink, icon: figma, label: "Figma / FigJam"]
}

app_scraper > package_database: workspace dependency
app_scraper > package_logger: workspace dependency
app_scraper > package_markdown: workspace dependency
app_scraper > package_services: workspace dependency
app_web > package_feature_flags: workspace dependency
app_web > package_logger: workspace dependency
app_web > package_services: workspace dependency
package_database > package_feature_flags: workspace dependency
package_services > package_database: workspace dependency
package_services > package_feature_flags: workspace dependency
package_services > package_storage: workspace dependency
package_services > package_logger: workspace dependency

legend [position: bottom-right] {
   [connection: >, label: "Runtime or deployment relationship"]
   [color: gray, label: "Shared code or tooling"]
   [color: green, label: "Production"]
   [color: blue, label: "Preview"]
   [color: yellow, label: "Development"]
}
